ShiftText_byHadynWiseman =LAMBDA(Text,Shift,[AlongShift],[AlongLettersOnly],[NoWrapAround],LET(l, SplitText_byHadynWiseman(Text), als, IF(AlongShift, AlongShift, 0), sym, EXACT(LOWER(l), UPPER(l)), upp, EXACT(UPPER(l), l), al, IF(AlongLettersOnly, SCAN(-als, sym, LAMBDA(a,v, IF(v, a, a + als))), SEQUENCE(LEN(Text), , 0, als)), mu, MOD(CODE(l) - 65 + Shift + al, 26) + 65, ml, MOD(CODE(l) - 97 + Shift + al, 26) + 97, nw, IFERROR(UNICHAR(UNICODE(l) + Shift + al), l), rs, IF(sym, l, IF(upp, CHAR(mu), CHAR(ml))), CONCAT(IF(NoWrapAround, nw, rs))));