GetBlock_byJaqKennedy =LAMBDA(Arr,AnchorCell,RowSize,[ColSize],[Pos],[Fill],[WrapAround],LET(nv,NOT(ISREF(Arr)),_PosUsed,IF(ISOMITTED(Pos)+ISBLANK(Pos),"C",Pos),_ColSizeUsed,IF(ISOMITTED(ColSize)+ISBLANK(ColSize),RowSize,ColSize),_FillUsed,IF(ISOMITTED(Fill),0,Fill),_WrapUsed,IF(ISOMITTED(WrapAround),0,WrapAround),_RowTL,IF(nv,1,@ROW(Arr)),_ColTL,IF(nv,1,@COLUMN(Arr)),_RowNumber,RowNum_byHadynWiseman(AnchorCell),_ColNumber,ColNum_byHadynWiseman(AnchorCell),_RowShiftPos,IF(LEFT(_PosUsed)="T",0,IF(LEFT(_PosUsed)="B",-(RowSize-1),-INT(RowSize/2))),_ColShiftPos,IF(RIGHT(_PosUsed)="L",0,IF(RIGHT(_PosUsed)="R",-(_ColSizeUsed-1),-INT(_ColSizeUsed/2))),_RowShift,INDEX(_RowNumber-_RowTL+_RowShiftPos,1,1),_ColShift,INDEX(_ColNumber-_ColTL+_ColShiftPos,1,1),_Shifted,ArrayShift_byHadynWiseman(Arr,-_RowShift,-_ColShift,_FillUsed,_WrapUsed),TAKE(_Shifted,RowSize,_ColSizeUsed)));