NetworkGraph_byHadynWiseman =LAMBDA(Starts,OriginDestinationTable,[Weights],[Function],[Targets],[BiDirectional],[StartWeights],[MaximiseW],[StepLimit],[ShowRoute],LET(ori, TAKE(OriginDestinationTable, , 1), des, TAKE(OriginDestinationTable, , -1), o, IF(BiDirectional, VSTACK(ori, des), ori), d, IF(BiDirectional, VSTACK(des, ori), des), w, IF(ISOMITTED(Weights), SEQUENCE(ROWS(o), , 1, 0), IF(BiDirectional, VSTACK(Weights, Weights), Weights)), st, IFNA(HSTACK(TOCOL(Starts), IF(ISOMITTED(StartWeights), 0, TOCOL(StartWeights)), 0, 0), 0), na, HSTACK(0, 0, 0, 0), fx, LAMBDA(lfx,pool,ft,n, LET(ct, IF(ISOMITTED(Function), BiRow_byHadynWiseman(ft, LAMBDA(r, IFERROR(EXPAND(FILTER(IFNA(HSTACK(d, MAP(w, LAMBDA(f, SUM(f, INDEX(r, 1, 2)))), n + 1), n + 1), o = INDEX(r, 1, 1)), , 4, INDEX(r, 1, 1)), r))), BiRow_byHadynWiseman(ft, LAMBDA(r, IFERROR(EXPAND(FILTER(IFNA(HSTACK(d, MAP(w, LAMBDA(f, Function(f, INDEX(r, 1, 2)))), n + 1), n + 1), o = INDEX(r, 1, 1)), , 4, INDEX(r, 1, 1)), r)))), pd, IFNA(XLOOKUP(TAKE(ct, , 1), TAKE(pool, , 1), CHOOSECOLS(pool, 2), , , 2), ""), ift, IF(MaximiseW, SORT(IF((CHOOSECOLS(ct, 2) > pd) + (pd = ""), ct, na), {1,2,3}, {1,1,1}), SORT(IF(CHOOSECOLS(ct, 2) < pd, ct, na), {1,2,3}, {1,-1,1})), nft, LET(au, UNIQUE(TAKE(ift, , 1)), a, HSTACK(au, VLOOKUP(au, ift, 2), VLOOKUP(au, ift, 3), VLOOKUP(au, ift, 4)), FILTER(a, TAKE(a, , 1) > 0, na)), npool, LET(b, IF(MaximiseW, SORT(VSTACK(pool, nft), {1,2}, {1,1}), SORT(VSTACK(pool, nft), {1,2}, {1,-1})), bu, UNIQUE(TAKE(b, , 1)), HSTACK(bu, VLOOKUP(bu, b, 2), VLOOKUP(bu, b, 3), VLOOKUP(bu, b, 4))), Stop, (SUM(nft) = 0) + ((StepLimit = n) * NOT(ISOMITTED(StepLimit))), IF(Stop, pool, lfx(lfx, npool, nft, n + 1)))), rs, fx(fx, st, st, 0), end, IF(ISOMITTED(Targets), rs, IF(ISOMITTED(ShowRoute), XLOOKUP(Targets, TAKE(rs, , 1), CHOOSECOLS(rs, 2), , , 2), LET(rt, SCAN(, VSTACK(Targets, SEQUENCE(XLOOKUP(Targets, TAKE(rs, , 1), CHOOSECOLS(rs, 3), , , 2))), LAMBDA(a,v, XLOOKUP(a, TAKE(rs, , 1), TAKE(rs, , -1), , , 2))), HSTACK(rt, VLOOKUP(rt, rs, 2))))), end));