LineOfSight_byHadynWiseman =LAMBDA(mp,Projections,blockers,[No_Diag],[Distance],[Custom_RC_Directions],[Fill], LET(M,10^6,R,ROWS(mp),C,COLUMNS(mp),rcn,SEQUENCE(R)*M+SEQUENCE(,C),fm,TOCOL(mp),fr,TOCOL(rcn),pm,ISNUMBER(XMATCH(fm,Projections)),st,FILTER(fr,pm,0),em,IF(mp="","",mp), IF(@st=0,em,LET(nm,FILTER(fm,pm),bk,FILTER(fr,ISNUMBER(XMATCH(fm,blockers)),-1), dr,IF(ISOMITTED(Custom_RC_Directions),TAKE(VSTACK(M,-M,1,-1,M+1,-M-1,M-1,1-M),8-4*No_Diag),TOCOL(Custom_RC_Directions,3)),td,TOROW(dr), sa,TOCOL(st+td*0),na,TOCOL(IF(td=td,nm)),da,TOCOL(st*0+td),dis,IF(ISOMITTED(Distance),MAX(R,C),Distance)+1,sq,SEQUENCE(,dis,0),pt,sa+da*sq, pr,INT(pt/M),pc,MOD(pt,M),sp,(pr<1)+(pr>R)+(pc<1)+(pc>C)+ISNUMBER(XMATCH(pt,bk)),si,BYROW(IF(sp,sq,dis),LAMBDA(x,MIN(x))), vp,FILTER(HSTACK(TOCOL(pt),TOCOL(IF(sq=sq,na))),TOCOL(sq<si)),up,UNIQUE(vp),uc,TAKE(up,,1), lut,IF(ISOMITTED(Fill),GROUPBY(uc,DROP(up,,1),LAMBDA(x,TEXTJOIN("/",1,x)),0,0),HSTACK(UNIQUE(uc),Fill)), IFNA(VLOOKUP(rcn,lut,2,0),em)))));