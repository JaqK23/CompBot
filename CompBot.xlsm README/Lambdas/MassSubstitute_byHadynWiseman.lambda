MassSubstitute_byHadynWiseman =LAMBDA(Text,OldText,[NewText],[CaseSensitive],[InstanceNumber],[Regexmode],MAP(Text,LAMBDA(x, LET(ot,IF(Regexmode,"","\Q")&TOCOL(OldText)&IF(Regexmode,"","\E"),nt,"\Q"&IF(ISOMITTED(NewText),EXPAND("",ROWS(ot),,""),NewText)&"\E",in,EXPAND(InstanceNumber,ROWS(ot),,@InstanceNumber), ms,REDUCE(x,SEQUENCE(ROWS(ot)),LAMBDA(a,v,REGEXREPLACE(a,INDEX(ot,v),INDEX(nt,v),IF(ISOMITTED(InstanceNumber),0,INDEX(in,v)),1-CaseSensitive))), ms))));