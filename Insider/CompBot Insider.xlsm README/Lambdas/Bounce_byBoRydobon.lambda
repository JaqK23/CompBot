Bounce_byBoRydobon =LAMBDA(n,max,[min],[start],[step],[leave0Clip1Bounce2],LET(mn,IF(ISOMITTED(min),1,min),st,IF(ISOMITTED(start),mn,start),sp,IF(ISOMITTED(step),1,step),mode,IF(ISOMITTED(leave0Clip1Bounce2),0,leave0Clip1Bounce2),of,MAX(mn,0)-mn+ABS(sp),top,max+of,bot,mn+of,q,SCAN(,VSTACK(st+of,SEQUENCE(n-1)),LAMBDA(a,v,LET(s,-1^(a<0),b,ABS(a)+s*sp,mb,MEDIAN(bot,b,top),-1^OR(b<=bot,top<=b)*s*CHOOSE(mode+1,b,mb,2*mb-b)))),ABS(q)-of));