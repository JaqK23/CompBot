StackSheets_byJaqKennedy =LAMBDA(blocks,names,[TopLeft],[HideBlanks],LET(n,COUNTA(names),r,ROWS(blocks)/n,c,COLUMNS(blocks),tl,IF(ISOMITTED(TopLeft),"A1",TopLeft),r0,RowNum_byHadynWiseman(tl),c0,ColNum_byHadynWiseman(tl),cells,r*c,k,SEQUENCE(n*cells)-1,idx,MOD(k,cells),sheet,TOCOL(IF(SEQUENCE(cells),TOROW(names)),,1),rw,r0+INT(idx/c),cl,c0+MOD(idx,c),val,TOCOL(blocks),data,HSTACK(sheet,val,ADDRESS(rw,cl,4),rw,cl,rw*10^6+cl),hide,IF(ISOMITTED(HideBlanks),0,HideBlanks),blank,IF(SEQUENCE(,6),""),kept,IF(hide,IFERROR(FILTER(data,(val<>"")*(val<>0)),blank),data),VSTACK(HSTACK("Sheet","Value","Address","Row","Col","RCRef"),kept)));