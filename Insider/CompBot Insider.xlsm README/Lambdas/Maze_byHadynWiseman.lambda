Maze_byHadynWiseman =LAMBDA(mp,st,[targets],[No_Diag],[AllowMp],[Custom_Directions],[ReferenceMap],LET(M,10^6,rm,ReferenceMap,nv,NOT(ISREF(mp)),mis,ISOMITTED(rm),IF(nv*mis,"Map is not a range, add reference map",LET( um,IF(mis,mp,rm),rn,ROW(um),cn,COLUMN(um),rcn,rn*M+cn, directions,{-1000000,-1,1,1000000,-1000001,-999999,999999,1000001},xRC,IF(ISOMITTED(Custom_Directions),TAKE(directions,,8-4*No_Diag),TOROW(Custom_Directions,3)), mpA,IF(ISOMITTED(AllowMp),mp,AllowMp),al,IF(Exists_byHadynWiseman("",TOCOL(mp)),"",0),   Rec,LAMBDA(f,a,LET(j,DROP(a,,1),i,MAX(j)+1,p,FILTER(a,j=i-1),     b,TAKE(p,,1)+xRC,br,INT(b/M),bc,MOD(b,M),c,IFS(br*bc*ISNA(XMATCH(b,TAKE(a,,1))),INDEX(mpA,br-@rn+1,bc-@cn+1)),     h,IFNA(HSTACK(UNIQUE(TOCOL(IFS(IF(ISOMITTED(AllowMp),c=al,c),b),3)),i),i),     IF(ISERR(@h),a,f(f,VSTACK(a,h))))), rs,Rec(Rec,IFNA(HSTACK(TOCOL(RowNum_byHadynWiseman(st)*M+ColNum_byHadynWiseman(st)),0),0)), final,IF(ISOMITTED(targets),IFNA(VLOOKUP(rcn,rs,2,0),""),IFNA(VLOOKUP(RowNum_byHadynWiseman(targets)*M+ColNum_byHadynWiseman(targets),rs,2,0),"OOB")), final))));