OptimiseTSP_byHadynWiseman =LAMBDA(GreedyResult,DistanceMatrix,     LET(         CurrentFloor,INDEX(GreedyResult,1),         PathString,INDEX(GreedyResult,2),         PathArr,--TEXTSPLIT(PathString,"|"),         N,COLUMNS(PathArr),         IsClosed,INDEX(PathArr,1)=INDEX(PathArr,N),          EdgesFrom,DROP(PathArr,,-1),         EdgesTo,DROP(PathArr,,1),         EdgeCosts,MAP(EdgesFrom,EdgesTo,LAMBDA(f,t,INDEX(DistanceMatrix,f,t))),          MaxIdx,XMATCH(MAX(EdgeCosts),EdgeCosts),         ExtractIdx,IF(AND(IsClosed,MaxIdx=N-1),MaxIdx,MaxIdx+1),         TargetNode,INDEX(PathArr,ExtractIdx),          SplicedPath,FILTER(PathArr,SEQUENCE(,N)<>ExtractIdx),         SweepCount,IF(IsClosed,N-2,N-1),          rs,REDUCE(GreedyResult,SEQUENCE(SweepCount),LAMBDA(a,v,             LET(                 BestDist,INDEX(a,1),                 Left,TAKE(SplicedPath,,v),                 Right,IFERROR(DROP(SplicedPath,,v),""),                 TestString,TEXTJOIN("|",1,Left,TargetNode,Right),                 TestPathArr,--TEXTSPLIT(TestString,"|"),                 TestFrom,DROP(TestPathArr,,-1),                 TestTo,DROP(TestPathArr,,1),                 TestDist,SUM(MAP(TestFrom,TestTo,LAMBDA(f,t,INDEX(DistanceMatrix,f,t)))),                 IF(TestDist<BestDist,HSTACK(TestDist,TestString),a)))),rs));