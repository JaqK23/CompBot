LineOfSightCount_byHadynWiseman =LAMBDA(st,mp,ItemsToCount,[Blockers],[No_Diag],[Distance],[Custom_Directions],[ReferenceMap], LET(M,10^6,rm,ReferenceMap,nv,NOT(ISREF(mp)),ms,ISOMITTED(rm), IF(nv*ms,"Map is not a range, add reference map", LET(um,IF(ms,mp,rm),rn,ROW(um),cn,COLUMN(um),mr,MIN(rn),xr,MAX(rn),mc,MIN(cn),xc,MAX(cn), fm,TOCOL(mp),fr,TOCOL(rn*M+cn),bk,FILTER(fr,ISNUMBER(XMATCH(fm,Blockers)),-1), dr,IF(ISOMITTED(Custom_Directions),TAKE(VSTACK(M,-M,1,-1,M+1,-M-1,M-1,1-M),8-4*No_Diag),TOCOL(Custom_Directions,3)), dis,IF(ISOMITTED(Distance),MAX(ROWS(um),COLUMNS(um)),Distance)+1,sq,SEQUENCE(,dis,0), pt,RCRefConvert_byHadynWiseman(st)+dr*sq, pr,INT(pt/M),pc,MOD(pt,M),sp,(pr<mr)+(pr>xr)+(pc<mc)+(pc>xc)+ISNUMBER(XMATCH(pt,bk)), si,BYROW(IF(sp,sq,dis),LAMBDA(x,MIN(x))), up,UNIQUE(FILTER(TOCOL(pt),TOCOL(sq<si))), SUM(--ISNUMBER(XMATCH(IFNA(XLOOKUP(up,fr,fm),""),ItemsToCount)))))));