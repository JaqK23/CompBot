TSPGreedy_byHadynWiseman =LAMBDA(DistanceMatrix,[StartNodeNumber],[ReturnToStart],     LET(         TotalNodes,ROWS(DistanceMatrix),         FirstNode,IF(ISOMITTED(StartNodeNumber),1,StartNodeNumber),         NodeSeq,SEQUENCE(,TotalNodes),         InitialState,HSTACK(FirstNode,0,FirstNode,--(NodeSeq=FirstNode)),         GreedyRun,REDUCE(InitialState,SEQUENCE(TotalNodes-1),LAMBDA(State,Step,             LET(                 Path,INDEX(State,1),                 TotalDistance,INDEX(State,2),                 LastNode,INDEX(State,3),                 VisitedArray,DROP(State,,3),                 AdjustedRow,CHOOSEROWS(DistanceMatrix,LastNode)+(VisitedArray*1E+99),                 NextDist,MIN(AdjustedRow),                 NextNode,XMATCH(NextDist,AdjustedRow),                 HSTACK(Path&"|"&NextNode,TotalDistance+NextDist,NextNode,VisitedArray+(NodeSeq=NextNode))))),         FinalPath,INDEX(GreedyRun,1),         FinalDist,INDEX(GreedyRun,2),         FinalNode,INDEX(GreedyRun,3),         BBInitialFloor,FinalDist+IF(ReturnToStart,INDEX(DistanceMatrix,FinalNode,FirstNode),0),         BBInitialpath,FinalPath&IF(ReturnToStart,"|"&FirstNode,""),         HSTACK(BBInitialFloor,BBInitialpath)));