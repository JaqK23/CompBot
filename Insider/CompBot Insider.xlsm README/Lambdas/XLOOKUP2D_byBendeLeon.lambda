XLOOKUP2D_byBendeLeon =LAMBDA(DataSource,RLU,CLU,[RowArray],[ColumnArray],[MatchMode],[SearchMode],[IfNotFound],LET(dropRow,IF(ISOMITTED(ColumnArray),1,0),dropCol,IF(ISOMITTED(RowArray),1,0),vals,DROP(DataSource,dropRow,dropCol),rlab,IF(ISOMITTED(RowArray),DROP(TAKE(DataSource,,1),dropRow),TAKE(RowArray,,1)),clab,IF(ISOMITTED(ColumnArray),DROP(TAKE(DataSource,1),,dropCol),TAKE(ColumnArray,1)),mm,IF(ISOMITTED(MatchMode),0,MatchMode),sm,IF(ISOMITTED(SearchMode),1,SearchMode),IFERROR(INDEX(vals,XMATCH(RLU,rlab,mm,sm),XMATCH(CLU,clab,mm,sm)),IF(ISOMITTED(IfNotFound),NA(),IfNotFound))));