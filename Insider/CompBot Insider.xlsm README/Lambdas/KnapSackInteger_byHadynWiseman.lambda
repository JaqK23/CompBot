KnapSackInteger_byHadynWiseman =LAMBDA(Capacity,Weights,Values,[items],LET(c,Capacity, rs,REDUCE(IFNA(HSTACK(EXPAND(0,c+1,,0),""),""),SEQUENCE(ROWS(Weights)),LAMBDA(a,v,LET( w,@INDEX(Weights,v),p,@INDEX(Values,v),pv,TAKE(a,,1),pl,DROP(a,,1), nv,IF(w>c,pv,IF(w=0,pv+p,VSTACK(EXPAND(0,w,,0),DROP(pv,-w)+p))), nl,IF(w>c,pl,IF(w=0,pl,VSTACK(EXPAND("",w,,""),DROP(pl,-w)))), k,nv>pv,HSTACK(IF(k,nv,pv),IF(k,nl&1,pl&0))))), IF(ISOMITTED(items),@TAKE(rs,-1,1),LET(b,@TAKE(rs,-1,-1),FILTER(HSTACK(items,Weights,Values),--MID(b,SEQUENCE(LEN(b)),1))))));